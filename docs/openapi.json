          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VotingSessionResponse"
                }
              }
            },
            "description": "A pauta já possui uma sessão"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Abre a sessão de votação de uma pauta (gestor)",
        "tags": [
          "Voting"
        ]
      }
    },
